{
  "builds": [
    {
      "src": "Jobsheet7/**/*.php",
      "use": "vercel-php"
    },
    {
      "src": "Jobsheet8/**/*.php",
      "use": "vercel-php"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/Jobsheet7/(.*)",
      "dest": "/Jobsheet7/$1"
    },
    {
      "src": "/Jobsheet8/(.*)",
      "dest": "/Jobsheet8/$1"
    }
  ]
}